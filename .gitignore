# Ключи и локальные настройки
.env

# Личные данные в репозиторий не кладём. Там раскладка гаража, рецепты
# и прочее, чему незачем лежать в истории git. Файлы остаются на диске
# и ассистент их видит - просто git их не отслеживает.
data/*
!data/README.md
# Шаблон рассказа о владельце: личного в нём нет, а под рукой нужен.
# Заполняется и переименовывается в about.md - тот уже в git не уедет.
!data/about.md.example

# Python
.venv/
__pycache__/
*.pyc

# Скачанные модели весят много, в репозиторий не кладём
models/

# Логи и отчёты прогонов
logs/*.log
logs/*.jsonl
logs/*.md

# Образцы голосов
samples/



# Настройки конкретной машины: адрес сервера, номер микрофона.
# У каждой машины свои, в общий конфиг им нельзя.
config.local.yaml

# Архивы для переноса на спутник: собираются из того, что уже в git.
*.rar
*.zip
