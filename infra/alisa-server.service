[Unit]
Description=Alisa server (whisper, Silero, agent)
Wants=network-online.target
After=network-online.target alisa-reminders.service

[Service]
Type=simple
# Заменить пользователя на своего.
User=alisa
WorkingDirectory=/home/chupep/dimarep
Environment=PYTHONIOENCODING=utf-8
# cuBLAS и cuDNN из pip: на Windows их находит _register_cuda_dlls в
# assistant/stt.py, на Linux каталоги нужно назвать до старта процесса.
Environment=LD_LIBRARY_PATH=/home/chupep/dimarep/.venv/lib/python3.10/site-packages/nvidia/cublas/lib:/home/chupep/dimarep/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib
ExecStart=/home/chupep/dimarep/.venv/bin/python -m assistant.cli --serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
