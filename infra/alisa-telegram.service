[Unit]
Description=Alisa Telegram bot
Wants=network-online.target
After=network-online.target alisa-server.service

[Service]
Type=simple
# Заменить пользователя на своего.
User=alisa
WorkingDirectory=/opt/alisa_selfhosted
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/alisa_selfhosted/.venv/bin/python -m assistant.telegram_bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
