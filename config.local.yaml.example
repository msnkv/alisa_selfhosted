# Настройки этой конкретной машины. Перекрывают config.yaml.
#
# Как пользоваться: переименуй в config.local.yaml и оставь только те
# строки, которые у этой машины отличаются. Всё остальное берётся из
# config.yaml, и его можно спокойно копировать с ПК сколько угодно —
# этот файл не пострадает.
#
# В git не попадает: у каждой машины свой.
#
# Ниже — то, чем спутник отличается от ПК. Раскомментируй и поправь
# адрес на тот, что показывает ipconfig на ПК.

# server:
#   url: "192.168.31.35:8765"
#   # Этот же адрес использует Telegram-бот: python -m assistant.telegram_bot
#   # token: "токен сервера, если включён"
#   # Необязательно: постоянный ID разговора этого спутника.
#   # Без него каждый запуск спутника начинает отдельную сессию.
#   # session_id: "satellite:kitchen"

# reminders:
#   # На ПК Алисы: адрес постоянно включённой машины со службой напоминаний.
#   url: "http://192.168.31.50:8766"
#   # На машине службы: слушать домашнюю сеть, хранить SQLite локально.
#   # host: "0.0.0.0"
#   # timezone: "Europe/Moscow"
#   # database: "state/reminders.sqlite3"
# Секрет REMINDERS_TOKEN в .env должен совпадать на обеих машинах.

# voice_stop:
#   enabled: true
#   # Если нужно временно оставить только ручную отмену: enabled: false
#   min_confidence: 0.9
#   echo_delay_ms: 0

# mic:
#   # На спутнике torch не ставим, конец фразы ловим по громкости.
#   vad: "energy"
#   # Если .\alisa.ps1 --mic-test скажет поставить другое число -
#   # вписывать сюда, а не в config.yaml.
#   energy_ratio: 2.0

# Что ещё имеет смысл держать тут, если разойдётся с ПК:
#
# tts:
#   output_device: null      номер колонки из --devices
# mic:
#   input_device: null       номер микрофона из --devices
# wake:
#   min_confidence: 0.8      если в этой комнате срабатывает хуже
