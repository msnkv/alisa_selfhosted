# Скопируй этот файл в .env и вставь свой ключ.
# .env добавлен в .gitignore и в репозиторий не попадёт.
DEEPSEEK_API_KEY=

# Telegram-клиент: токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Твой числовой ID. Если пусто, бот по /start покажет ID,
# но вопросы к Алисе принимать не будет. Впиши ID и перезапусти бота.
TELEGRAM_ALLOWED_USER_ID=
