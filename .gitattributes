# cmd читает .bat только с переводами строк CRLF. С LF он пытается
# выполнять строки комментариев как команды - проверено.
*.bat text eol=crlf
*.ps1 text eol=crlf
# Скрипты и службы для Linux-сервера: с CRLF bash падает на «$'\r'».
*.sh text eol=lf
infra/*.service text eol=lf
infra/*.timer text eol=lf
infra/*.example text eol=lf
